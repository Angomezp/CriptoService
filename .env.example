# Seguridad y Cifrado (AES-256-CBC)
# REQUISITO: ENCRYPTION_KEY debe ser una cadena en hexadecimal de exactamente 64 caracteres (32 bytes).
# Se puede generar en terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY = <>

# JWT
# REQUISITO: strings hexadecimales de 128 caracteres (64 bytes).
# Se genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET = <>
JWT_MFA_SECRET = <>

MAX_INTENTOS_LOGIN = <> # Número máximo de intentos fallidos antes de bloquear
BLOQUEO_MINUTOS = <> # Minutos de bloqueo tras alcanzar el máximo de intentos

# Configuración SMTP para envío de correos (Gmail con App Password)
SMTP_HOST = <>            # Host SMTP del proveedor (ej. smtp.gmail.com)
SMTP_PORT = <>            # Puerto SMTP (587 para STARTTLS)
SMTP_USER = <>            # Correo remitente
SMTP_PASS = <>            # App Password del correo (NO la contraseña normal)
SMTP_FROM = <>            # Remitente con formato: Nombre <correo>
APP_URL = <>              # URL base del frontend (para construir links de recuperación)
PASSWORD_RESET_TTL_MIN = <>  # Minutos antes de que el token de recuperación expire
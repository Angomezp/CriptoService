# Archivo de ejemplo para variables de entorno

# Variables de entorno para el servidor
SV_PORT = <>      #-> Puerto en el que se ejecutará el servidor

# Variables de entorno para la base de datos

DB_TYPE = <>   #-> Motor de la base de datos (e.g., postgresql, mysql, etc.)
DB_HOST = <>   #-> Host de la base de datos
DB_PORT = <>   #-> Puerto de la base de datos
DB_USER = <>   #-> Usuario de la base de datos
DB_PASSWORD = <>   #-> Contraseña de la base de datos
DB_NAME = <>   #-> Nombre de la base de datos

# Variables de entorno para ml_service
COINGECKO_API_URL = "https://api.coingecko.com/api/v3"   #-> URL base de la API de CoinGecko
COINGECKO_API_KEY = ""  #-> Clave de API para CoinGecko 
ML_SV_PORT = <>     #-> Puerto en el que se ejecutará el servicio de machine learning
ML_SV_HOST = ""     #-> Host en el que se ejecutará el servicio de machine learning (e.g., "0.0.0.0")
ML_SERVICE_URL = ""  #-> URL del servicio de machine learning (ajustar según sea necesario)

ML_MODELS_DIRECTORY = ""  #-> Directorio donde se almacenarán los modelos entrenados (ml_service/models por defecto)

ML_MINIMUM_DATA_POINTS = <>  #-> Número mínimo de puntos de datos necesarios para entrenar un modelo (200 por defecto, ajustar según necesidades)

ML_TRAINING_COOLDOWN_HOURS = <>  #-> Horas de enfriamiento entre entrenamientos para evitar sobrecarga (24 horas por defecto)

ML_DEFAULT_N_ESTIMATORS = <>  #-> Número de árboles para Random Forest  (100 por defecto, ajustar según necesidades)

ML_DEFAULT_MAX_DEPTH = <>  #-> Profundidad máxima para Random Forest (defecto: 4 entrenamiento rapido, None para sin límite)
ML_DEFAULT_LEARNING_RATE = <>  #-> Tasa de aprendizaje para modelos como Gradient Boosting (defecto: 0.05, ajustar según necesidades)
ML_DEFAULT_RANDOM_STATE = <>  #-> Semilla para reproducibilidad en Random Forest (defecto: 42, ajustar según necesidades)
ML_DEFAULT_N_JOBS = <>  #-> Número de hilos en paralelos para Random Forest (defecto: 1, -1 para usar todos los núcleos)
ML_DEFAULT_OBJECTIVE = <>  #  Objetivo para XGBoost (defecto: "reg:squarederror" para regresión, ajustar según tipo de modelo)


# Variables de entorno para la API de machine learning en conexión Node.js <-> Python
ML_API_KEY = <>  #-> Clave de API para autenticar peticiones entre Node.js y Python (puede ser cualquier string seguro)



# Seguridad y Cifrado (AES-256-CBC)
# REQUISITO: ENCRYPTION_KEY debe ser una cadena en hexadecimal de exactamente 64 caracteres (32 bytes).
# Se puede generar en terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY = <>

# JWT
# REQUISITO: strings hexadecimales de 128 caracteres (64 bytes).
# Se genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET = <>
JWT_MFA_SECRET = <>

MAX_INTENTOS_LOGIN = <> # Número máximo de intentos fallidos antes de bloquear
BLOQUEO_MINUTOS = <> # Minutos de bloqueo tras alcanzar el máximo de intentos

# Configuración SMTP para envío de correos (Gmail con App Password)
SMTP_HOST = <>            # Host SMTP del proveedor (ej. smtp.gmail.com)
SMTP_PORT = <>            # Puerto SMTP (587 para STARTTLS)
SMTP_USER = <>            # Correo remitente
SMTP_PASS = <>            # App Password del correo (NO la contraseña normal)
SMTP_FROM = <>            # Remitente con formato: Nombre <correo>
APP_URL = <>              # URL base del frontend (para construir links de recuperación)
PASSWORD_RESET_TTL_MIN = <>  # Minutos antes de que el token de recuperación expire